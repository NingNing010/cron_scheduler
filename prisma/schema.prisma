generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id             Int       @id @default(autoincrement())
  name           String
  cronExpression String    // Sẽ chứa chuỗi 6 trường (có giây)
  recipientEmail String    // Email người nhận
  subject        String    // Tiêu đề email
  content        String    // Nội dung email
  status         String    @default("ACTIVE")
  sendCount      Int       @default(0)
  maxMailCount   Int       @default(5)
  pausedReason   String?
  finishedAt     DateTime?
  nextRun        DateTime?
  createdAt      DateTime  @default(now())
  
  logs           JobLog[]  // Quan hệ 1-N với bảng Log
}

model JobLog {
  id          Int      @id @default(autoincrement())
  taskId      Int
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status      String   // "SENDING", "COMPLETED", "FAILED"
  message     String?  // Ghi chú (Hoặc chi tiết lỗi nếu thất bại)
  executedAt  DateTime @default(now())
}

model Employee {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  fullName         String
  email            String   @unique
  phone            String?
  department       String?
  position         String?
  notes            String?
  avatarKey        String?
  avatarUrl        String?
  isSynced         Boolean  @default(false)
  syncedAt         DateTime?
  sourceUpdatedAt  DateTime?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SyncRunLog {
  id            Int      @id @default(autoincrement())
  jobName       String
  status        String
  sourceCount   Int      @default(0)
  syncedCount   Int      @default(0)
  failedCount   Int      @default(0)
  message       String?
  executedAt    DateTime @default(now())
}

model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  fullName    String?
  roleId      Int?
  role        Role?    @relation(fields: [roleId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[] @relation("RolePermissions")
}
